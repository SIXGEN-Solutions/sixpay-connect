# ============================================================
# SIXPAY CONNECT
# Global Git ignore rules
# ============================================================


# ============================================================
# OPERATING SYSTEM
# ============================================================

# Windows
Thumbs.db
Thumbs.db:encryptable
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~
.fuse_hidden*
.directory
.Trash-*


# ============================================================
# IDE AND EDITORS
# ============================================================

# IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws
out/

# Visual Studio Code
.vscode/

# Eclipse
.project
.classpath
.settings/
.factorypath

# NetBeans
nbproject/private/
nbbuild/
dist/
nbdist/
.nb-gradle/

# Editor temporary files
*.swp
*.swo
*.bak
*.diff
*.patch
*.tmp


# ============================================================
# JAVA / MAVEN BACKEND
# ============================================================

# Maven build directories
target/
**/target/

# Maven release plugin
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties

# Maven wrapper binary downloaded locally
.mvn/wrapper/maven-wrapper.jar

# Java compiled files
*.class

# Java crash logs
hs_err_pid*
replay_pid*

# JaCoCo reports and execution data
jacoco.exec
*.exec

# Spring Boot generated files
spring.log


# ============================================================
# ANGULAR / NODE FRONTEND
# ============================================================

# Dependencies
node_modules/
**/node_modules/

# Angular build output
dist/
**/dist/

# Angular cache
.angular/
**/.angular/

# Node and npm caches
.npm/
.nx/
.cache/

# Test coverage
coverage/
**/coverage/

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# TypeScript incremental compilation
*.tsbuildinfo

# Temporary frontend files
.tmp/
.temp/


# ============================================================
# ENVIRONMENT AND SECRETS
# ============================================================

# Environment files
.env
.env.*
!.env.example

# Local application configuration
application-local.yml
application-local.yaml
application-local.properties

application-secret.yml
application-secret.yaml
application-secret.properties

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx
*.jks

# Keep public examples and templates when provided
!*.example.pem
!*.example.key
!*.example.yml
!*.example.yaml
!*.example.properties


# ============================================================
# LOGS
# ============================================================

*.log
logs/
**/logs/


# ============================================================
# DATABASE
# ============================================================

# Local database files
*.db
*.sqlite
*.sqlite3

# Database dumps
*.dump
*.sql.gz

# Keep versioned Flyway migrations
!backend/**/src/main/resources/db/migration/*.sql


# ============================================================
# DOCKER
# ============================================================

# Docker local override
docker-compose.override.yml
compose.override.yml

# Local Docker data
.docker-data/
docker-data/


# ============================================================
# KUBERNETES / HELM / TERRAFORM
# ============================================================

# Local Kubernetes configuration
kubeconfig
kubeconfig.*
.kube/

# Helm generated packages
*.tgz

# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
.terraform.lock.hcl.backup
crash.log
crash.*.log

# Terraform variable files may contain secrets
*.tfvars
*.tfvars.json

# Keep example variable files
!*.tfvars.example
!*.tfvars.json.example


# ============================================================
# TEST RESULTS
# ============================================================

test-results/
**/test-results/
playwright-report/
**/playwright-report/
playwright-report-*/
**/playwright-report-*/

surefire-reports/
failsafe-reports/


# ============================================================
# TEMPORARY AND GENERATED FILES
# ============================================================

tmp/
temp/
*.cache.sixpay-recovery/

# Python validation caches
__pycache__/
*.py[cod]
