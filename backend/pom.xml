<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- ========================================================= -->
    <!-- PROJECT IDENTIFICATION                                    -->
    <!-- ========================================================= -->

    <groupId>com.sixpay</groupId>
    <artifactId>sixpay-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>

    <packaging>pom</packaging>

    <name>SIXPAY CONNECT</name>

    <description>
        Parent Maven project and build configuration for SIXPAY CONNECT.
    </description>

    <url>https://github.com/SIXGEN-Solutions/sixpay-connect</url>

    <!-- ========================================================= -->
    <!-- ORGANIZATION                                              -->
    <!-- ========================================================= -->

    <organization>
        <name>SIXGEN Solutions</name>
        <url>https://github.com/SIXGEN-Solutions</url>
    </organization>

    <!-- ========================================================= -->
    <!-- LICENSE                                                   -->
    <!-- ========================================================= -->

    <licenses>
        <license>
            <name>Proprietary</name>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <!-- ========================================================= -->
    <!-- SOURCE CONTROL                                            -->
    <!-- ========================================================= -->

    <scm>
        <connection>
            scm:git:https://github.com/SIXGEN-Solutions/sixpay-connect.git
        </connection>

        <developerConnection>
            scm:git:https://github.com/SIXGEN-Solutions/sixpay-connect.git
        </developerConnection>

        <url>
            https://github.com/SIXGEN-Solutions/sixpay-connect
        </url>

        <tag>HEAD</tag>
    </scm>

    <!-- ========================================================= -->
    <!-- GLOBAL PROPERTIES                                         -->
    <!-- ========================================================= -->

    <properties>

        <!-- Project version -->

        <revision>1.0.0-SNAPSHOT</revision>

        <!-- Java -->

        <java.version>21</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>

        <!-- Encoding -->

        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Maven requirements -->

        <maven.minimum.version>3.9.6</maven.minimum.version>

        <!-- Build behavior -->

        <maven.test.failure.ignore>false</maven.test.failure.ignore>
        <skipITs>true</skipITs>

        <!--
            Used only by spring-boot:run.
            Unit and integration tests always use the Spring "test" profile.
        -->

        <app.runtime.profile>dev</app.runtime.profile>

        <!-- Maven plugins -->

        <maven.clean.plugin.version>3.5.0</maven.clean.plugin.version>
        <maven.resources.plugin.version>3.5.0</maven.resources.plugin.version>
        <maven.compiler.plugin.version>3.15.0</maven.compiler.plugin.version>
        <maven.surefire.plugin.version>3.5.6</maven.surefire.plugin.version>
        <maven.failsafe.plugin.version>3.5.6</maven.failsafe.plugin.version>
        <maven.jar.plugin.version>3.5.1</maven.jar.plugin.version>
        <maven.install.plugin.version>3.1.4</maven.install.plugin.version>
        <maven.deploy.plugin.version>3.1.4</maven.deploy.plugin.version>
        <maven.enforcer.plugin.version>3.6.3</maven.enforcer.plugin.version>

        <!-- Spring Boot Maven plugin -->

        <spring.boot.maven.plugin.version>3.5.6</spring.boot.maven.plugin.version>

        <!-- Code coverage -->

        <jacoco.maven.plugin.version>0.8.13</jacoco.maven.plugin.version>

    </properties>

    <!-- ========================================================= -->
    <!-- MAVEN MODULES                                             -->
    <!-- ========================================================= -->

    <modules>

        <!-- Dependency governance -->

        <module>sixpay-bom</module>

        <!-- Platform modules -->

        <module>common</module>
        <module>shared-kernel</module>
        <module>security</module>
        <module>integration</module>

        <!-- Business domains -->

        <module>customer</module>
        <module>partner</module>
        <module>subscription</module>
        <module>payment</module>
        <module>accounting</module>
        <module>reporting</module>
        <module>notification</module>
        <module>administration</module>

        <!-- Executable application -->

        <module>bootstrap</module>

    </modules>

    <!-- ========================================================= -->
    <!-- DEPENDENCY MANAGEMENT                                     -->
    <!-- ========================================================= -->

    <dependencyManagement>
        <dependencies>

            <!-- SIXPAY dependency platform -->

            <dependency>
                <groupId>com.sixpay</groupId>
                <artifactId>sixpay-bom</artifactId>
                <version>${revision}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

        </dependencies>
    </dependencyManagement>

    <!-- ========================================================= -->
    <!-- BUILD CONFIGURATION                                       -->
    <!-- ========================================================= -->

    <build>

        <!-- ===================================================== -->
        <!-- PLUGIN MANAGEMENT                                     -->
        <!-- ===================================================== -->

        <pluginManagement>
            <plugins>

                <!-- Clean -->

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>${maven.clean.plugin.version}</version>
                </plugin>

                <!-- Resources -->

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>${maven.resources.plugin.version}</version>

                    <configuration>
                        <encoding>${project.build.sourceEncoding}</encoding>
                    </configuration>
                </plugin>

                <!-- Java compilation -->

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven.compiler.plugin.version}</version>

                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <encoding>${project.build.sourceEncoding}</encoding>
                        <parameters>true</parameters>
                        <showWarnings>true</showWarnings>
                    </configuration>
                </plugin>

                <!-- Unit tests -->

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven.surefire.plugin.version}</version>

                    <configuration>
                        <failIfNoTests>false</failIfNoTests>
                        <useModulePath>false</useModulePath>

                        <includes>
                            <include>**/*Test.java</include>
                            <include>**/*Tests.java</include>
                        </includes>

                        <systemPropertyVariables>
                            <spring.profiles.active>test</spring.profiles.active>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>

                <!-- Integration tests -->

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${maven.failsafe.plugin.version}</version>

                    <configuration>
                        <skipITs>${skipITs}</skipITs>
                        <failIfNoTests>false</failIfNoTests>
                        <useModulePath>false</useModulePath>

                        <includes>
                            <include>**/*IT.java</include>
                            <include>**/*ITCase.java</include>
                        </includes>

                        <systemPropertyVariables>
                            <spring.profiles.active>test</spring.profiles.active>
                        </systemPropertyVariables>
                    </configuration>

                    <executions>
                        <execution>
                            <id>integration-tests</id>

                            <goals>
                                <goal>integration-test</goal>
                                <goal>verify</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <!-- Standard JAR packaging -->

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven.jar.plugin.version}</version>
                </plugin>

                <!-- Local repository installation -->

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>${maven.install.plugin.version}</version>
                </plugin>

                <!-- Artifact deployment -->

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>${maven.deploy.plugin.version}</version>
                </plugin>

                <!-- Maven and Java validation -->

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>${maven.enforcer.plugin.version}</version>

                    <executions>
                        <execution>
                            <id>enforce-build-environment</id>

                            <goals>
                                <goal>enforce</goal>
                            </goals>

                            <configuration>
                                <rules>

                                    <requireMavenVersion>
                                        <version>
                                            [${maven.minimum.version},)
                                        </version>

                                        <message>
                                            SIXPAY CONNECT requires Maven
                                            ${maven.minimum.version} or later.
                                        </message>
                                    </requireMavenVersion>

                                    <requireJavaVersion>
                                        <version>[21,22)</version>

                                        <message>
                                            SIXPAY CONNECT must be built with JDK 21.
                                        </message>
                                    </requireJavaVersion>

                                </rules>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>

                <!-- Spring Boot executable packaging -->

                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring.boot.maven.plugin.version}</version>

                    <configuration>
                        <profiles>${app.runtime.profile}</profiles>

                        <layers>
                            <enabled>true</enabled>
                        </layers>
                    </configuration>

                    <executions>
                        <execution>
                            <id>repackage</id>

                            <goals>
                                <goal>repackage</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <!-- Code coverage -->

                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.maven.plugin.version}</version>

                    <executions>
                        <execution>
                            <id>prepare-jacoco-agent</id>

                            <goals>
                                <goal>prepare-agent</goal>
                            </goals>
                        </execution>

                        <execution>
                            <id>generate-jacoco-report</id>
                            <phase>verify</phase>

                            <goals>
                                <goal>report</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

            </plugins>
        </pluginManagement>

        <!-- ===================================================== -->
        <!-- TRANSVERSE PLUGINS                                    -->
        <!-- ===================================================== -->

        <plugins>

            <!-- Applied to every Java module -->

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>

            <!-- Build environment validation -->

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
            </plugin>

        </plugins>

    </build>

    <!-- ========================================================= -->
    <!-- MAVEN PROFILES                                            -->
    <!-- ========================================================= -->

    <profiles>

        <!-- ===================================================== -->
        <!-- DEVELOPMENT                                           -->
        <!-- ===================================================== -->

        <profile>
            <id>dev</id>

            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>

            <properties>
                <app.runtime.profile>dev</app.runtime.profile>
                <skipITs>true</skipITs>
            </properties>
        </profile>

        <!-- ===================================================== -->
        <!-- TEST                                                  -->
        <!-- ===================================================== -->

        <profile>
            <id>test</id>

            <properties>
                <app.runtime.profile>test</app.runtime.profile>
                <skipITs>false</skipITs>
            </properties>

            <build>
                <plugins>

                    <!-- Activated only for the complete test build -->

                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                    </plugin>

                </plugins>
            </build>
        </profile>

        <!-- ===================================================== -->
        <!-- PRODUCTION                                            -->
        <!-- ===================================================== -->

        <profile>
            <id>prod</id>

            <properties>
                <app.runtime.profile>prod</app.runtime.profile>
                <skipITs>false</skipITs>
            </properties>
        </profile>

    </profiles>

</project>