--- a/backend/tests/pom.xml
+++ b/backend/tests/pom.xml
@@
   <profiles>
+    <!-- ========================================================= -->
+    <!-- 8.3.2 Payment / Customer Observation                    -->
+    <!-- ========================================================= -->
+    <profile>
+      <id>payment-customer-tests</id>
+
+      <!--
+        The production cross-module glue lives in bootstrap.
+        Keep it profile-scoped so GoldenModuleE2EIT and the default
+        backend/tests classpath remain unchanged.
+      -->
+      <dependencies>
+        <dependency>
+          <groupId>com.sixpay</groupId>
+          <artifactId>bootstrap</artifactId>
+          <version>${project.version}</version>
+          <scope>test</scope>
+        </dependency>
+      </dependencies>
+
+      <build>
+        <plugins>
+          <plugin>
+            <groupId>org.codehaus.mojo</groupId>
+            <artifactId>build-helper-maven-plugin</artifactId>
+            <version>3.6.1</version>
+            <executions>
+              <execution>
+                <id>add-payment-customer-test-source</id>
+                <phase>generate-test-sources</phase>
+                <goals>
+                  <goal>add-test-source</goal>
+                </goals>
+                <configuration>
+                  <sources>
+                    <source>
+                      src/payment-customer-test/java
+                    </source>
+                  </sources>
+                </configuration>
+              </execution>
+
+              <execution>
+                <id>add-payment-customer-test-resource</id>
+                <phase>generate-test-resources</phase>
+                <goals>
+                  <goal>add-test-resource</goal>
+                </goals>
+                <configuration>
+                  <resources>
+                    <resource>
+                      <directory>
+                        src/payment-customer-test/resources
+                      </directory>
+                    </resource>
+                  </resources>
+                </configuration>
+              </execution>
+            </executions>
+          </plugin>
+        </plugins>
+      </build>
+    </profile>
+
     <!-- keep the existing assembled-tests profile unchanged -->
   </profiles>
