<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- ========================================================= -->
    <!-- PARENT                                                    -->
    <!-- ========================================================= -->

    <parent>
        <groupId>com.sixpay</groupId>
        <artifactId>sixpay-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <!-- ========================================================= -->
    <!-- MODULE IDENTIFICATION                                     -->
    <!-- ========================================================= -->

    <artifactId>security</artifactId>
    <packaging>jar</packaging>

    <name>SIXPAY CONNECT - Security</name>

    <description>
        Authentication, authorization and security infrastructure
        for SIXPAY CONNECT.
    </description>

    <!-- ========================================================= -->
    <!-- DEPENDENCIES                                              -->
    <!-- ========================================================= -->

    <dependencies>

        <!-- SIXPAY technical components -->

        <dependency>
            <groupId>com.sixpay</groupId>
            <artifactId>common</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Spring Security -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- OAuth2 Resource Server and JWT -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>
                spring-boot-starter-oauth2-resource-server
            </artifactId>
        </dependency>

        <!-- Unit tests -->

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Spring Security test utilities -->

        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

</project>