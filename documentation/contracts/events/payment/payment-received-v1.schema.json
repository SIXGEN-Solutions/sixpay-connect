{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sixpay:event:payment.received.v1",
  "title": "PaymentReceivedV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "paymentId",
    "publicPaymentReference",
    "partnerId",
    "financialInstitutionCode",
    "amount",
    "currency",
    "receivedAt"
  ],
  "properties": {
    "paymentId": {
      "type": "string",
      "minLength": 1
    },
    "publicPaymentReference": {
      "type": "string",
      "minLength": 1
    },
    "partnerId": {
      "type": "string",
      "minLength": 1
    },
    "financialInstitutionCode": {
      "type": "string",
      "minLength": 1
    },
    "amount": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "receivedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
