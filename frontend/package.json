{
  "name": "frontend",
  "version": "0.0.0",
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": ">=10 <12"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "ng test --watch=false",
    "contract:partner": "node verify-partner-openapi.mjs",
    "gate:3": "npm run contract:partner && npm run lint && npm run test && npm run build && npm run format:check",
    "gate:4": "npm run contract:partner && npm run lint && npm run test && npm run build && npm run format:check"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.18",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.18",
    "@angular/compiler": "^21.2.18",
    "@angular/core": "^21.2.18",
    "@angular/forms": "^21.2.18",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.18",
    "@angular/platform-browser-dynamic": "^21.2.18",
    "@angular/router": "^21.2.18",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.19",
    "@angular/cli": "^21.2.19",
    "@angular/compiler-cli": "^21.2.18",
    "angular-eslint": "^21.4.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10",
    "yaml": "^2.8.1"
  }
}
