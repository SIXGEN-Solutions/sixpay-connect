# Local Docker stack only. Never store real credentials here.
POSTGRES_DB=sixpaydb
POSTGRES_USER=sixpay_user
POSTGRES_PASSWORD=sixpay_password
POSTGRES_PORT=15432

BACKEND_PORT=8080
FRONTEND_PORT=8088

# Local SMTP capture service.
# SMTP is consumed internally by the backend at mailpit:1025.
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Accounting TresorPay status sandbox.
# Supply real sandbox values only in your local .env / deployment secret store.
# Do not commit secrets.
# TRESORPAY_STATUS_BASE_URL=https://...
# TRESORPAY_STATUS_PATH=/api/v1/payments/{reference}/status
# TRESORPAY_STATUS_OAUTH2_REGISTRATION_ID=tresorpay-status
# TRESORPAY_STATUS_SSL_BUNDLE=tresorpay-status-client
