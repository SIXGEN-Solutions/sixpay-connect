{
  "realm": "sixpay-m2m-local",
  "enabled": true,
  "displayName": "SIXPAY M2M - LOCAL TEST ONLY",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "resetPasswordAllowed": false,
  "accessTokenLifespan": 300,
  "clientScopes": [
    {
      "name": "payment.initiate",
      "description": "SIXPAY payment initiation - machine client only",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    }
  ],
  "clients": [
    {
      "clientId": "sixpay-partner-test",
      "name": "SIXPAY external partner (local M2M test)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${SIXPAY_M2M_TEST_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "authorizationServicesEnabled": false,
      "fullScopeAllowed": false,
      "optionalClientScopes": [
        "payment.initiate"
      ],
      "protocolMappers": [
        {
          "name": "local-test-self-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "sixpay-partner-test",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "local-sixpay-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "sixpay-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ]
}
